<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Review | Wanderlust</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50 text-gray-800">

    <!-- HEADER -->
    <%- include("../includes/navbar.ejs") %>

    <!-- MAIN -->
    <main class="max-w-3xl mx-auto px-4 py-12">

        <!-- CARD -->
        <div class="bg-white shadow-xl rounded-2xl p-8">

            <h1 class="text-2xl font-semibold mb-2">
                Write a review
            </h1>

            <p class="text-gray-500 mb-6">
                For: <span class="font-medium text-gray-700">
                    <%= listing.title %>
                </span>
            </p>

            <!-- REVIEW FORM -->
            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="space-y-6">

                <!-- RATING -->
                <div>
                    <label class="block text-sm font-medium mb-2">
                        Rating
                    </label>

                    <select name="review[rating]" required
                        class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-rose-400 focus:outline-none">
                        <option value="">Select rating</option>
                        <option value="1">⭐ 1 - Poor</option>
                        <option value="2">⭐⭐ 2 - Fair</option>
                        <option value="3">⭐⭐⭐ 3 - Good</option>
                        <option value="4">⭐⭐⭐⭐ 4 - Very Good</option>
                        <option value="5">⭐⭐⭐⭐⭐ 5 - Excellent</option>
                    </select>
                </div>

                <!-- COMMENT -->
                <div>
                    <label class="block text-sm font-medium mb-2">
                        Your Review
                    </label>

                    <textarea name="review[comment]" rows="4" required
                        class="w-full border rounded-lg p-3 focus:ring-2 focus:ring-rose-400 focus:outline-none resize-none"
                        placeholder="Share your experience..."></textarea>
                </div>

                <!-- BUTTONS -->
                <div class="flex flex-col sm:flex-row gap-4">

                    <button type="submit"
                        class="px-6 py-3 bg-rose-500 text-white rounded-lg font-medium hover:bg-rose-600 transition w-full sm:w-auto">
                        Submit Review
                    </button>

                    <a href="/listings/<%= listing._id %>"
                        class="px-6 py-3 border rounded-lg text-gray-700 hover:bg-gray-100 transition text-center w-full sm:w-auto">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </main>

    <!-- FOOTER -->
    <%- include("../includes/footer.ejs") %>

</body>

</html>