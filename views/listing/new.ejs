<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add New Listing | Wanderlust</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50 text-gray-800">

    <!-- HEADER -->
    <%- include("../includes/navbar.ejs") %>

        <!-- MAIN -->
        <main class="max-w-3xl mx-auto px-4 py-10">

            <h1 class="text-4xl font-bold text-center mb-2">
                Create a New Listing
            </h1>

            <p class="text-center text-gray-500 mb-10">
                Share your beautiful property with travelers around the world.
            </p>


            <!-- FORM -->
            <form action="/listings" method="POST" enctype="multipart/form-data"
                class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8 space-y-7">


                <!-- TITLE -->
                <div>

                    <label class="block text-sm font-medium mb-1">
                        Title
                    </label>

                    <input type="text" name="listing[title]" placeholder="Beautiful apartment in city center"
                        class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-rose-500 focus:ring-4 focus:ring-rose-100 transition duration-200"
                        required />

                </div>


                <!-- DESCRIPTION -->
                <div>

                    <label class="block text-sm font-medium mb-1">
                        Description
                    </label>

                    <textarea name="listing[description]" rows="4" placeholder="Describe your place..."
                        class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-rose-500 focus:ring-4 focus:ring-rose-100 transition duration-200"
                        required></textarea>

                </div>


                <!-- PROPERTY IMAGES -->
                <div>

                    <label class="block text-sm font-semibold mb-3">
                        Property Images
                    </label>


                    <!-- UPLOAD BOX -->
                    <label for="image"
                        class="flex flex-col items-center justify-center w-full h-56 border-2 border-dashed border-gray-300 rounded-2xl cursor-pointer hover:border-rose-400 hover:bg-rose-50 transition">

                        <!-- ICON -->
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 text-rose-500 mb-3" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">

                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"
                                d="M3 16.5V18a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 18v-1.5M16.5 12L12 7.5m0 0L7.5 12M12 7.5V16" />

                        </svg>


                        <p id="uploadText" class="font-medium text-gray-700 transition">

                            Click to upload property images

                        </p>


                        <p id="uploadSubText" class="text-sm text-gray-400 mt-2 transition">

                            Select up to 5 images • PNG, JPG, JPEG

                        </p>


                        <!-- MULTIPLE IMAGE INPUT -->
                        <input id="image" type="file" name="listing[image]" accept="image/*" multiple class="hidden"
                            required>

                    </label>


                    <!-- IMAGE PREVIEW -->
                    <div id="previewContainer" class="hidden mt-5 grid grid-cols-2 sm:grid-cols-3 gap-4">
                    </div>

                </div>


                <!-- PRICE -->
                <div>

                    <label class="block text-sm font-medium mb-1">
                        Price (per night)
                    </label>

                    <input type="number" name="listing[price]" placeholder="2500" min="0"
                        class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-rose-500 focus:ring-4 focus:ring-rose-100 transition duration-200"
                        required />

                </div>


                <!-- LOCATION -->
                <div>

                    <label class="block text-sm font-medium mb-1">
                        Location
                    </label>

                    <input type="text" name="listing[location]" placeholder="Kolkata"
                        class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-rose-500 focus:ring-4 focus:ring-rose-100 transition duration-200"
                        required />

                </div>


                <!-- COUNTRY -->
                <div>

                    <label class="block text-sm font-medium mb-1">
                        Country
                    </label>

                    <input type="text" name="listing[country]" placeholder="India"
                        class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:border-rose-500 focus:ring-4 focus:ring-rose-100 transition duration-200"
                        required />

                </div>

                <!-- CATEGORY -->
                <div class="relative">

                    <label class="block text-sm font-medium mb-2">
                        Category
                    </label>

                    <!-- Custom Dropdown -->
                    <div class="relative">

                        <button type="button" id="categoryDropdownBtn"
                            class="w-full flex items-center justify-between bg-white border border-gray-300 rounded-xl px-4 py-3.5 text-left outline-none hover:border-gray-400 focus:border-rose-500 focus:ring-4 focus:ring-rose-100 transition-all duration-200">

                            <div class="flex items-center gap-3">

                                <!-- Category Icon -->
                                <div class="w-9 h-9 rounded-lg bg-rose-50 flex items-center justify-center">

                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-rose-500" fill="none"
                                        viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">

                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M4 7h16M4 12h16M4 17h16" />

                                    </svg>

                                </div>

                                <span id="selectedCategory" class="text-gray-500 text-sm">
                                    Select a category
                                </span>

                            </div>

                            <!-- Arrow -->
                            <svg id="categoryArrow" xmlns="http://www.w3.org/2000/svg"
                                class="w-5 h-5 text-gray-400 transition-transform duration-200" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />

                            </svg>

                        </button>


                        <!-- Dropdown Menu -->
                        <div id="categoryDropdown"
                            class="hidden absolute left-0 right-0 mt-2 bg-white border border-gray-200 rounded-2xl shadow-xl overflow-hidden z-50">

                            <div class="max-h-64 overflow-y-auto p-2">

                                <button type="button" data-value="beach" class="category-option">
                                    Beach
                                </button>

                                <button type="button" data-value="mountain" class="category-option">
                                    Mountain
                                </button>

                                <button type="button" data-value="camping" class="category-option">
                                    Camping
                                </button>

                                <button type="button" data-value="cabins" class="category-option">
                                    Cabins
                                </button>

                                <button type="button" data-value="tropical" class="category-option">
                                    Tropical
                                </button>

                                <button type="button" data-value="castles" class="category-option">
                                    Castles
                                </button>

                                <button type="button" data-value="lakefront" class="category-option">
                                    Lakefront
                                </button>

                                <button type="button" data-value="island" class="category-option">
                                    Island
                                </button>

                                <button type="button" data-value="amazing-views" class="category-option">
                                    Amazing Views
                                </button>

                                <button type="button" data-value="tiny-homes" class="category-option">
                                    Tiny Homes
                                </button>

                                <button type="button" data-value="tree-houses" class="category-option">
                                    Tree Houses
                                </button>

                                <button type="button" data-value="farms" class="category-option">
                                    Farms
                                </button>

                                <button type="button" data-value="city" class="category-option">
                                    City
                                </button>

                                <button type="button" data-value="arctic" class="category-option">
                                    Arctic
                                </button>

                                <button type="button" data-value="desert" class="category-option">
                                    Desert
                                </button>

                                <button type="button" data-value="luxury" class="category-option">
                                    Luxury
                                </button>

                                <button type="button" data-value="national-parks" class="category-option">
                                    National Parks
                                </button>

                                <button type="button" data-value="rooms" class="category-option">
                                    Rooms
                                </button>

                            </div>

                        </div>

                    </div>


                    <!-- Hidden input -->
                    <input type="hidden" id="categoryInput" name="listing[category]" required>

                </div>


                <!-- ACTIONS -->
                <div class="flex justify-end gap-4 pt-4">

                    <a href="/listings"
                        class="px-5 py-2.5 rounded-lg border text-gray-600 hover:bg-gray-100 transition">

                        Cancel

                    </a>


                    <button type="submit"
                        class="px-6 py-2.5 rounded-lg bg-rose-500 text-white font-medium hover:bg-rose-600 transition">

                        Create Listing

                    </button>

                </div>

            </form>

        </main>


        <!-- FOOTER -->
        <%- include("../includes/footer.ejs") %>


            <script>

                // ==========================================
                // IMAGE UPLOAD & MULTIPLE IMAGE PREVIEW
                // ==========================================

                const imageInput =
                    document.getElementById("image");

                const previewContainer =
                    document.getElementById("previewContainer");

                const uploadText =
                    document.getElementById("uploadText");

                const uploadSubText =
                    document.getElementById("uploadSubText");


                imageInput.addEventListener("change", (e) => {

                    const files = Array.from(e.target.files);


                    // ==========================================
                    // NO FILE SELECTED
                    // ==========================================

                    if (files.length === 0) {

                        previewContainer.innerHTML = "";

                        previewContainer.classList.add("hidden");

                        uploadText.innerHTML =
                            "Click to upload property images";

                        uploadText.classList.remove("text-green-600");

                        uploadText.classList.add("text-gray-700");

                        uploadSubText.innerHTML =
                            "Select up to 5 images • PNG, JPG, JPEG";

                        return;

                    }


                    // ==========================================
                    // MAXIMUM 5 IMAGES
                    // ==========================================

                    if (files.length > 5) {

                        alert("You can upload a maximum of 5 images.");

                        imageInput.value = "";

                        previewContainer.innerHTML = "";

                        previewContainer.classList.add("hidden");

                        uploadText.innerHTML =
                            "Click to upload property images";

                        uploadText.classList.remove("text-green-600");

                        uploadText.classList.add("text-gray-700");

                        uploadSubText.innerHTML =
                            "Select up to 5 images • PNG, JPG, JPEG";

                        return;

                    }


                    // ==========================================
                    // CLEAR OLD PREVIEWS
                    // ==========================================

                    previewContainer.innerHTML = "";


                    // ==========================================
                    // CREATE PREVIEW FOR EACH IMAGE
                    // ==========================================

                    files.forEach((file, index) => {

                        const previewWrapper =
                            document.createElement("div");

                        previewWrapper.className =
                            "relative overflow-hidden rounded-xl border border-gray-200 bg-gray-50";


                        // IMAGE
                        const image =
                            document.createElement("img");

                        image.src =
                            URL.createObjectURL(file);

                        image.className =
                            "w-full h-40 object-cover";


                        // IMAGE NUMBER
                        const imageNumber =
                            document.createElement("div");

                        imageNumber.className =
                            "absolute top-2 left-2 w-7 h-7 rounded-full bg-rose-500 text-white text-xs font-semibold flex items-center justify-center shadow";

                        imageNumber.innerText =
                            index + 1;


                        // FILE NAME
                        const fileName =
                            document.createElement("div");

                        fileName.className =
                            "px-3 py-2 text-xs text-gray-600 truncate bg-white";

                        fileName.innerText =
                            file.name;


                        // APPEND ELEMENTS
                        previewWrapper.appendChild(image);

                        previewWrapper.appendChild(imageNumber);

                        previewWrapper.appendChild(fileName);

                        previewContainer.appendChild(previewWrapper);

                    });


                    // ==========================================
                    // SHOW PREVIEW CONTAINER
                    // ==========================================

                    previewContainer.classList.remove("hidden");


                    // ==========================================
                    // UPDATE UPLOAD TEXT
                    // ==========================================

                    uploadText.innerHTML =
                        `✅ ${files.length} image${files.length > 1 ? "s" : ""} selected`;

                    uploadText.classList.remove("text-gray-700");

                    uploadText.classList.add("text-green-600");


                    // ==========================================
                    // UPDATE SUB TEXT
                    // ==========================================

                    uploadSubText.innerHTML =
                        "You can upload up to 5 images";

                });



                // ==========================================
                // CATEGORY DROPDOWN
                // ==========================================

                const categoryDropdownBtn =
                    document.getElementById("categoryDropdownBtn");

                const categoryDropdown =
                    document.getElementById("categoryDropdown");

                const categoryArrow =
                    document.getElementById("categoryArrow");

                const selectedCategory =
                    document.getElementById("selectedCategory");

                const categoryInput =
                    document.getElementById("categoryInput");

                const categoryOptions =
                    document.querySelectorAll(".category-option");


                // ==========================================
                // OPEN / CLOSE CATEGORY DROPDOWN
                // ==========================================

                categoryDropdownBtn.addEventListener("click", (event) => {

                    event.stopPropagation();

                    categoryDropdown.classList.toggle("hidden");

                    categoryArrow.classList.toggle("rotate-180");

                });


                // ==========================================
                // SELECT CATEGORY
                // ==========================================

                categoryOptions.forEach(option => {

                    option.addEventListener("click", (event) => {

                        event.stopPropagation();


                        // Get category value
                        const value =
                            option.dataset.value;


                        // Get category display name
                        const label =
                            option.innerText.trim();


                        // Update selected category text
                        selectedCategory.innerText =
                            label;


                        // Change text color
                        selectedCategory.classList.remove(
                            "text-gray-500"
                        );

                        selectedCategory.classList.add(
                            "text-gray-800",
                            "font-medium"
                        );


                        // Store category value
                        // This will be submitted with the form
                        categoryInput.value =
                            value;


                        // Remove previous active state
                        categoryOptions.forEach(item => {

                            item.classList.remove(
                                "bg-rose-50",
                                "text-rose-600"
                            );

                        });


                        // Highlight selected category
                        option.classList.add(
                            "bg-rose-50",
                            "text-rose-600"
                        );


                        // Close dropdown
                        categoryDropdown.classList.add(
                            "hidden"
                        );

                        categoryArrow.classList.remove(
                            "rotate-180"
                        );

                    });

                });



                // ==========================================
                // CLOSE DROPDOWN WHEN CLICKING OUTSIDE
                // ==========================================

                document.addEventListener("click", (event) => {

                    if (
                        !categoryDropdownBtn.contains(event.target) &&
                        !categoryDropdown.contains(event.target)
                    ) {

                        categoryDropdown.classList.add(
                            "hidden"
                        );

                        categoryArrow.classList.remove(
                            "rotate-180"
                        );

                    }

                });


            </script>


</body>

</html>