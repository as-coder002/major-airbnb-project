<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Wanderlust</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-gray-50">

    <%- include("../includes/flash.ejs") %>

        <main class="min-h-[100vh] flex items-center justify-center px-4 py-12">

            <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-8">

                <div class="text-center mb-8">
                    <h1 class="text-3xl font-bold text-gray-800">
                        Welcome Back
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Login to continue your Wanderlust journey.
                    </p>
                </div>

                <form action="/login" method="POST" class="space-y-5">

                    <!-- Username -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Username
                        </label>

                        <input type="text" name="username" required placeholder="Enter username"
                            class="w-full px-4 py-3 border rounded-xl focus:ring-2 focus:ring-rose-500 focus:outline-none">
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Password
                        </label>

                        <div class="relative">

                            <input type="password" id="password" name="password" required placeholder="Enter password"
                                class="w-full px-4 py-3 border rounded-xl focus:ring-2 focus:ring-rose-500 focus:outline-none">

                            <button type="button" id="togglePassword"
                                class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500">
                                👁️
                            </button>

                        </div>
                    </div>

                    <button type="submit"
                        class="w-full bg-rose-500 hover:bg-rose-600 text-white py-3 rounded-xl font-medium transition">
                        Login
                    </button>

                </form>

                <div class="text-center mt-6">
                    <p class="text-sm text-gray-500">
                        Don't have an account?
                        <a href="/signup" class="text-rose-500 font-medium hover:underline">
                            Sign up
                        </a>
                    </p>
                </div>

            </div>

        </main>


        <script>
            const passwordInput = document.getElementById("password");
            const togglePassword = document.getElementById("togglePassword");

            togglePassword.addEventListener("click", () => {

                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    togglePassword.textContent = "🙈";
                } else {
                    passwordInput.type = "password";
                    togglePassword.textContent = "👁️";
                }

            });
        </script>

</body>

</html>