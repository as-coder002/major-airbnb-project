<!-- DESKTOP SEARCH BAR -->
<div class="hidden lg:flex flex-1 justify-center px-10">

    <form action="/listings/search" method="GET" id="searchBar"
        class="flex items-center bg-white border border-gray-300 rounded-full shadow-sm hover:shadow-md transition-all duration-300 px-2 py-2 w-full max-w-xl overflow-hidden">

        <!-- Anywhere -->
        <div id="searchAnywhere"
            class="px-6 text-sm font-medium text-gray-800 whitespace-nowrap transition-all duration-300">

            Anywhere

        </div>


        <!-- Divider -->
        <div id="dividerOne" class="h-6 w-px bg-gray-300 transition-all duration-500">
        </div>


        <!-- Add Dates -->
        <div id="searchWeek"
            class="px-6 text-sm font-medium text-gray-800 whitespace-nowrap transition-all duration-500">

            Add Dates

        </div>


        <!-- Divider -->
        <div id="dividerTwo" class="h-6 w-px bg-gray-300 transition-all duration-500">
        </div>


        <!-- SEARCH INPUT + BUTTON -->
        <div class="flex items-center justify-between flex-1 pl-6 pr-1">

            <!-- Search Input -->
            <input type="text" name="q" id="searchInput" placeholder="Search destinations..." autocomplete="off"
                class="w-full min-w-0 bg-transparent border-none outline-none focus:ring-0 text-sm text-gray-800 placeholder:text-gray-500" />


            <!-- Search Button -->
            <button type="submit" aria-label="Search"
                class="flex-shrink-0 w-10 h-10 rounded-full bg-rose-500 hover:bg-rose-600 transition-all duration-300 flex items-center justify-center">

                <!-- Search SVG -->
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">

                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-4.35-4.35m1.35-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />

                </svg>

            </button>

        </div>

    </form>

</div>